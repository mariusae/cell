graph home #6a52a3bd (uid)
  %0 = param uid
  %1 = call get_user(%0)               pure  seq=0             examples/home.py:109
  %2 = op %1.id                                                examples/home.py:110
  %3 = call get_prefs(%2)              effectful[main]  seq=1  examples/home.py:110
  %4 = call get_items(%0)              pure  seq=2             examples/home.py:111
  %5 = op %1.tier                                              examples/home.py:112
  %6 = op %5 == 'premium'                                      examples/home.py:112
  %7 = guard %6 == True                                        examples/home.py:112
  %8 = call rank(%4, %3)               pure  seq=3             examples/home.py:113
  %9 = op greeting(%1)                                         examples/home.py:116
  %10 = pack Page(title=%9, items=%8)
  return %10
