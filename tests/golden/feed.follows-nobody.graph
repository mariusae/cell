graph feed #da391f8e (uid, k)
  %0 = param uid
  %1 = param k
  %2 = source now()                  seq=0        feed.py:75
  %3 = call following(%0)            pure  seq=1  feed.py:76
  %4 = op len(%3)                                 feed.py:77
  %5 = guard %4 == 0                              feed.py:77
  %6 = op top_k((), %1)                           feed.py:81
  %7 = op truth(%6)                               feed.py:82
  %8 = guard %7 == False                          feed.py:82
  %9 = pack Feed(user=%0, posts=%6)
  return %9
