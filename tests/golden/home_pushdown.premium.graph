graph home_pushdown #e6a3d5d5 (uid)
  %0 = param uid
  %1 = call get_user(%0)               pure  seq=0             examples/home.py:122
  %2 = op %1.id                                                examples/home.py:123
  %3 = call get_prefs(%2)              effectful[main]  seq=1  examples/home.py:123
  %4 = call get_items(%0)              pure  seq=2             examples/home.py:124
  %5 = op %1.tier                                              examples/home.py:125
  %6 = op %5 == 'premium'                                      examples/home.py:125
  %7 = guard %6 == True                                        examples/home.py:125
  %8 = call rank(%4, %3)               pure  seq=3             examples/home.py:126
  %9 = op greeting(%1)                                         examples/home.py:129
  %10 = pack Page(title=%9, items=%8)
  return %10
